{
  "name": "memorial-planning-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "prototype:preview": "vite --host 127.0.0.1 --port 3001",
    "lint": "tsc --noEmit",
    "test": "node --import ./tests/register-css.mjs --import tsx --test tests/*.test.tsx",
    "catalog:security:start": "node scripts/catalog-security/start-local.mjs",
    "catalog:security:test": "node supabase/tests/integration.mjs",
    "catalog:security:preflight": "node supabase/tests/preflight.mjs --remote",
    "admin:dev": "npm run dev --prefix apps/admin",
    "admin:build": "npm run build --prefix apps/admin",
    "catalog:media:check": "node scripts/catalog-security/cleanup-media.mjs",
    "catalog:security:migrate:local": "node scripts/catalog-security/apply-local-migrations.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
