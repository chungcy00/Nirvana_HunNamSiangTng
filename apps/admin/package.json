{
  "name": "nirvana-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3002",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup:local": "node scripts/local-env.mjs",
    "test:integration": "node --import tsx tests/integration.mjs",
    "test:e2e": "node tests/browser.mjs",
    "format": "prettier --write src server api tests scripts *.ts *.json index.html",
    "format:check": "prettier --check src server api tests scripts *.ts *.json index.html",
    "test:auth": "node tests/auth-security.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "0.546.0",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.14.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "5.8.2",
    "vite": "6.4.5"
  }
}
